{
  "version": 8,
  "name": "Ancient Japan Study Atlas",
  "metadata": {
    "reader:purpose": "Zoom-aware historical study atlas",
    "reader:projection-policy": "North-up, two-dimensional, maximum zoom limited by evidence resolution"
  },
  "sprite": "__SPRITE_URL__",
  "sources": {
    "terrain": {
      "type": "raster",
      "tiles": ["__TERRAIN_TILES__"],
      "tileSize": 256,
      "minzoom": 3,
      "maxzoom": 10,
      "bounds": [118.5, 25.5, 148.0, 46.5],
      "attribution": "Terrain: Copernicus DEM and GEBCO"
    },
    "atlas": {
      "type": "vector",
      "url": "pmtiles://__ATLAS_ARCHIVE__",
      "attribution": "GSHHG; MLIT; Ancient Japan Study Atlas; province proxy: CODH (CC BY-NC)"
    },
    "ch01-features": {
      "type": "geojson",
      "data": "__CHAPTER_FEATURES__"
    },
    "ch01-routes": {
      "type": "geojson",
      "data": "__CHAPTER_ROUTES__"
    },
    "ch01-regions": {
      "type": "geojson",
      "data": "__CHAPTER_REGIONS__"
    }
  },
  "layers": [
    {
      "id": "paper-sea",
      "type": "background",
      "paint": {"background-color": "#cfe8f3"}
    },
    {
      "id": "terrain-relief",
      "type": "raster",
      "source": "terrain",
      "paint": {
        "raster-opacity": 0.82,
        "raster-saturation": -0.2,
        "raster-contrast": -0.04,
        "raster-fade-duration": 0,
        "raster-resampling": "linear"
      }
    },
    {
      "id": "land-wash",
      "type": "fill",
      "source": "atlas",
      "source-layer": "land",
      "paint": {
        "fill-color": "#c8bd80",
        "fill-opacity": 0.1
      }
    },
    {
      "id": "historical-regions",
      "type": "fill",
      "source": "atlas",
      "source-layer": "historical_regions",
      "filter": ["==", ["get", "period"], "__PERIOD__"],
      "paint": {
        "fill-color": "__ACCENT__",
        "fill-opacity": [
          "match", ["get", "confidence"],
          "high", 0.22,
          "medium", 0.16,
          "low", 0.1,
          0.14
        ]
      }
    },
    {
      "id": "historical-region-boundaries",
      "type": "line",
      "source": "atlas",
      "source-layer": "historical_regions",
      "filter": ["==", ["get", "period"], "__PERIOD__"],
      "paint": {
        "line-color": "__ACCENT__",
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.8, 8, 2.1],
        "line-opacity": 0.7,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "ritsuryo-provinces-fill",
      "type": "fill",
      "source": "atlas",
      "source-layer": "ritsuryo_provinces",
      "minzoom": 5,
      "layout": {"visibility": "none"},
      "filter": [
        "all",
        ["<=", ["get", "valid_from"], "__MAP_DATE__"],
        [">=", ["get", "valid_to"], "__MAP_DATE__"]
      ],
      "paint": {"fill-color": "#b69149", "fill-opacity": 0.055}
    },
    {
      "id": "ritsuryo-provinces-line",
      "type": "line",
      "source": "atlas",
      "source-layer": "ritsuryo_provinces",
      "minzoom": 5,
      "layout": {"visibility": "none"},
      "filter": [
        "all",
        ["<=", ["get", "valid_from"], "__MAP_DATE__"],
        [">=", ["get", "valid_to"], "__MAP_DATE__"]
      ],
      "paint": {
        "line-color": "#6f5d40",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.55, 9, 1.3],
        "line-opacity": 0.54,
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "lakes",
      "type": "fill",
      "source": "atlas",
      "source-layer": "lakes",
      "minzoom": 5,
      "paint": {
        "fill-color": "#cfe7f0",
        "fill-opacity": 0.92,
        "fill-outline-color": "#2a93ca"
      }
    },
    {
      "id": "rivers-glow",
      "type": "line",
      "source": "atlas",
      "source-layer": "rivers_primary",
      "minzoom": 5,
      "paint": {
        "line-color": "#b8dce8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1.4, 9, 4.2],
        "line-opacity": 0.8
      }
    },
    {
      "id": "rivers",
      "type": "line",
      "source": "atlas",
      "source-layer": "rivers_primary",
      "minzoom": 5,
      "paint": {
        "line-color": "#1f8cc8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.65, 9, 2],
        "line-opacity": 0.9
      }
    },
    {
      "id": "historical-routes",
      "type": "line",
      "source": "atlas",
      "source-layer": "historical_routes",
      "filter": [">=", ["index-of", "__PERIOD__", ["coalesce", ["get", "period"], ""]], 0],
      "paint": {
        "line-color": "#a64b3c",
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 1.4, 9, 3.2],
        "line-opacity": [
          "match", ["get", "confidence"],
          "high", 0.88,
          "medium", 0.72,
          "low", 0.52,
          0.64
        ],
        "line-dasharray": [4, 2]
      }
    },
    {
      "id": "chapter-routes",
      "type": "line",
      "source": "atlas",
      "source-layer": "chapter_routes",
      "filter": [">=", ["index-of", "__PLATE__", ["coalesce", ["get", "plates"], ""]], 0],
      "paint": {
        "line-color": "#a64b3c",
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 1.8, 9, 4.4],
        "line-opacity": 0.86,
        "line-dasharray": [2, 1.5]
      }
    },
    {
      "id": "coastline",
      "type": "line",
      "source": "atlas",
      "source-layer": "land",
      "paint": {
        "line-color": "#35575d",
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.55, 9, 1.7],
        "line-opacity": 0.86
      }
    },
    {
      "id": "ch01-regions",
      "type": "fill",
      "source": "ch01-regions",
      "filter": [">=", ["index-of", "__SCENE__", ["coalesce", ["get", "scenes"], ""]], 0],
      "paint": {
        "fill-color": [
          "match", ["get", "period_family"],
          "paleolithic", "#566675",
          "jomon", "#9A6044",
          "yayoi", "#B8893F",
          "record", "#53648A",
          "traditional", "#76566E",
          "#70685D"
        ],
        "fill-opacity": [
          "match", ["get", "certainty"],
          "secure", 0.17,
          "approximate", 0.12,
          "disputed", 0.07,
          0.1
        ]
      }
    },
    {
      "id": "ch01-region-boundaries",
      "type": "line",
      "source": "ch01-regions",
      "filter": [">=", ["index-of", "__SCENE__", ["coalesce", ["get", "scenes"], ""]], 0],
      "paint": {
        "line-color": [
          "match", ["get", "period_family"],
          "paleolithic", "#566675",
          "jomon", "#9A6044",
          "yayoi", "#B8893F",
          "record", "#53648A",
          "traditional", "#76566E",
          "#70685D"
        ],
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.7, 9, 1.8],
        "line-opacity": ["match", ["get", "certainty"], "disputed", 0.35, 0.55],
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "ch01-routes-inferred",
      "type": "line",
      "source": "ch01-routes",
      "filter": [
        "all",
        [">=", ["index-of", "__SCENE__", ["coalesce", ["get", "scenes"], ""]], 0],
        ["!=", ["get", "certainty"], "secure"],
        ["!=", ["get", "certainty"], "traditional"]
      ],
      "paint": {
        "line-color": [
          "match", ["get", "route_family"],
          "movement", "#566675",
          "exchange", "#8A5A3D",
          "diffusion", "#B8893F",
          "record", "#53648A",
          "traditional", "#76566E",
          "#70685D"
        ],
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 1.5, 9, 3.7],
        "line-opacity": ["match", ["get", "certainty"], "disputed", 0.48, 0.72],
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "ch01-routes-secure",
      "type": "line",
      "source": "ch01-routes",
      "filter": [
        "all",
        [">=", ["index-of", "__SCENE__", ["coalesce", ["get", "scenes"], ""]], 0],
        ["==", ["get", "certainty"], "secure"]
      ],
      "paint": {
        "line-color": [
          "match", ["get", "route_family"],
          "movement", "#566675",
          "exchange", "#8A5A3D",
          "diffusion", "#B8893F",
          "record", "#53648A",
          "traditional", "#76566E",
          "#70685D"
        ],
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 1.6, 9, 4],
        "line-opacity": 0.88
      }
    },
    {
      "id": "ch01-routes-traditional",
      "type": "line",
      "source": "ch01-routes",
      "filter": [
        "all",
        [">=", ["index-of", "__SCENE__", ["coalesce", ["get", "scenes"], ""]], 0],
        ["==", ["get", "certainty"], "traditional"]
      ],
      "paint": {
        "line-color": "#76566E",
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 2.2, 9, 4.8],
        "line-opacity": 0.88,
        "line-dasharray": [1, 1.7]
      }
    },
    {
      "id": "ch01-focus-halo",
      "type": "circle",
      "source": "ch01-features",
      "filter": [
        "all",
        [">=", ["index-of", "__SCENE__", ["coalesce", ["get", "scenes"], ""]], 0],
        [">=", ["index-of", "__SCENE__", ["coalesce", ["get", "focus_scenes"], ""]], 0],
        ["!=", ["get", "category"], "landscape"]
      ],
      "paint": {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 3, 7, 9, 16],
        "circle-color": "rgba(241,235,221,0.34)",
        "circle-stroke-color": "rgba(241,235,221,0.92)",
        "circle-stroke-width": 2,
        "circle-blur": 0.22
      }
    },
    {
      "id": "ch01-feature-markers",
      "type": "circle",
      "source": "ch01-features",
      "filter": [
        "all",
        [">=", ["index-of", "__SCENE__", ["coalesce", ["get", "scenes"], ""]], 0],
        ["!=", ["get", "category"], "landscape"]
      ],
      "paint": {
        "circle-radius": [
          "interpolate", ["linear"], ["zoom"],
          3, ["match", ["get", "rank"], 1, 4.8, 2, 3.8, 3.1],
          11, ["match", ["get", "rank"], 1, 9.5, 2, 7.4, 5.8]
        ],
        "circle-color": [
          "match", ["get", "period_family"],
          "paleolithic", "#566675",
          "jomon", "#9A6044",
          "yayoi", "#B8893F",
          "record", "#53648A",
          "traditional", "#76566E",
          "#70685D"
        ],
        "circle-opacity": ["match", ["get", "certainty"], "disputed", 0.58, "approximate", 0.78, 0.92],
        "circle-stroke-color": "#F7F1E4",
        "circle-stroke-width": ["interpolate", ["linear"], ["zoom"], 3, 1.2, 11, 2.3]
      }
    },
    {
      "id": "ch01-feature-symbols",
      "type": "symbol",
      "source": "ch01-features",
      "filter": [
        "all",
        [">=", ["index-of", "__SCENE__", ["coalesce", ["get", "scenes"], ""]], 0],
        ["!=", ["get", "category"], "landscape"]
      ],
      "layout": {
        "icon-image": [
          "concat",
          ["coalesce", ["get", "period_family"], "neutral"],
          "-",
          ["coalesce", ["get", "category"], "settlement"]
        ],
        "icon-size": [
          "interpolate", ["linear"], ["zoom"],
          3, ["match", ["get", "rank"], 1, 0.64, 2, 0.52, 0.43],
          9, ["match", ["get", "rank"], 1, 1.08, 2, 0.88, 0.7]
        ],
        "icon-allow-overlap": true,
        "icon-ignore-placement": true
      },
      "paint": {
        "icon-opacity": [
          "match", ["get", "certainty"],
          "secure", 0.98,
          "approximate", 0.82,
          "disputed", 0.58,
          0.86
        ]
      }
    },
    {
      "id": "ch01-region-labels",
      "type": "symbol",
      "source": "ch01-regions",
      "filter": [
        "all",
        [">=", ["index-of", "__SCENE__", ["coalesce", ["get", "scenes"], ""]], 0],
        ["!=", ["literal", "__SCENE__"], ["literal", "memory"]]
      ],
      "layout": {
        "text-field": ["get", "map_label"],
        "text-font": ["Georgia", "Palatino Linotype", "Times New Roman"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 12, 9, 17],
        "text-letter-spacing": 0.06,
        "text-transform": "uppercase",
        "text-allow-overlap": false,
        "text-padding": 8,
        "symbol-sort-key": ["coalesce", ["get", "rank"], 5]
      },
      "paint": {
        "text-color": "#453A31",
        "text-halo-color": "rgba(239,233,219,0.9)",
        "text-halo-width": 1.8
      }
    },
    {
      "id": "ch01-landscape-labels",
      "type": "symbol",
      "source": "ch01-features",
      "filter": [
        "all",
        [">=", ["index-of", "__SCENE__", ["coalesce", ["get", "scenes"], ""]], 0],
        ["==", ["get", "category"], "landscape"]
      ],
      "layout": {
        "text-field": ["get", "map_label"],
        "text-font": ["Georgia", "Palatino Linotype", "Times New Roman"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 11, 9, 16],
        "text-letter-spacing": 0.08,
        "text-allow-overlap": false,
        "text-padding": 6,
        "symbol-sort-key": ["coalesce", ["get", "rank"], 5]
      },
      "paint": {
        "text-color": "#57483B",
        "text-opacity": 0.74,
        "text-halo-color": "rgba(239,233,219,0.92)",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "ch01-focus-labels",
      "type": "symbol",
      "source": "ch01-features",
      "filter": [
        "all",
        [">=", ["index-of", "__SCENE__", ["coalesce", ["get", "scenes"], ""]], 0],
        [">=", ["index-of", "__SCENE__", ["coalesce", ["get", "focus_scenes"], ""]], 0],
        ["!=", ["get", "category"], "landscape"]
      ],
      "layout": {
        "text-field": ["get", "map_label"],
        "text-font": ["Arial Unicode MS Regular", "Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 13, 9, 18],
        "text-variable-anchor": ["top", "bottom", "left", "right"],
        "text-radial-offset": 0.95,
        "text-allow-overlap": false,
        "text-padding": 5,
        "symbol-sort-key": ["coalesce", ["get", "rank"], 5]
      },
      "paint": {
        "text-color": "#2F2924",
        "text-halo-color": "rgba(247,241,228,0.96)",
        "text-halo-width": 2.2
      }
    },
    {
      "id": "ch01-context-labels",
      "type": "symbol",
      "source": "ch01-features",
      "minzoom": 3.5,
      "filter": [
        "all",
        [">=", ["index-of", "__SCENE__", ["coalesce", ["get", "scenes"], ""]], 0],
        ["<", ["get", "rank"], 3],
        ["!=", ["get", "category"], "landscape"]
      ],
      "layout": {
        "text-field": ["get", "map_label"],
        "text-font": ["Arial Unicode MS Regular", "Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 12, 9, 16],
        "text-variable-anchor": ["top", "bottom", "left", "right"],
        "text-radial-offset": 0.85,
        "text-allow-overlap": false,
        "text-padding": 5,
        "symbol-sort-key": ["coalesce", ["get", "rank"], 5]
      },
      "paint": {
        "text-color": "#4C433B",
        "text-opacity": 0.86,
        "text-halo-color": "rgba(247,241,228,0.94)",
        "text-halo-width": 2
      }
    },
    {
      "id": "ch01-route-labels",
      "type": "symbol",
      "source": "ch01-routes",
      "minzoom": 3.5,
      "filter": [
        "all",
        [">=", ["index-of", "__SCENE__", ["coalesce", ["get", "scenes"], ""]], 0],
        ["==", ["get", "rank"], 1]
      ],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 420,
        "text-field": ["get", "map_label"],
        "text-font": ["Georgia", "Palatino Linotype", "Times New Roman"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 12, 9, 16],
        "text-letter-spacing": 0.03,
        "text-max-angle": 30,
        "text-allow-overlap": false,
        "text-padding": 5
      },
      "paint": {
        "text-color": "#4A4037",
        "text-halo-color": "rgba(247,241,228,0.95)",
        "text-halo-width": 2
      }
    },
    {
      "id": "historical-sites-halo",
      "type": "circle",
      "source": "atlas",
      "source-layer": "historical_sites",
      "filter": [
        "any",
        [">=", ["index-of", "__SITE_PERIOD_1__", ["coalesce", ["get", "periods"], ""]], 0],
        [">=", ["index-of", "__SITE_PERIOD_2__", ["coalesce", ["get", "periods"], ""]], 0],
        [">=", ["index-of", "__SITE_PERIOD_3__", ["coalesce", ["get", "periods"], ""]], 0]
      ],
      "paint": {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 4, 4.2, 9, 9],
        "circle-color": "rgba(236,228,210,0.92)"
      }
    },
    {
      "id": "historical-sites",
      "type": "circle",
      "source": "atlas",
      "source-layer": "historical_sites",
      "filter": [
        "any",
        [">=", ["index-of", "__SITE_PERIOD_1__", ["coalesce", ["get", "periods"], ""]], 0],
        [">=", ["index-of", "__SITE_PERIOD_2__", ["coalesce", ["get", "periods"], ""]], 0],
        [">=", ["index-of", "__SITE_PERIOD_3__", ["coalesce", ["get", "periods"], ""]], 0]
      ],
      "paint": {
        "circle-radius": [
          "interpolate", ["linear"], ["zoom"],
          4, ["match", ["get", "tier"], 1, 3.6, 2, 2.8, 2.2],
          9, ["match", ["get", "tier"], 1, 7, 2, 5.5, 4.5]
        ],
        "circle-color": "__ACCENT__",
        "circle-stroke-color": "#3d3026",
        "circle-stroke-width": 0.8
      }
    },
    {
      "id": "study-sites-halo",
      "type": "circle",
      "source": "atlas",
      "source-layer": "study_labels",
      "filter": [
        "all",
        [">=", ["index-of", "__PLATE__", ["coalesce", ["get", "plates"], ""]], 0],
        ["!", ["in", ["get", "category"], ["literal", ["plain", "mountain", "pass", "bay", "sea", "region", "external_polity", "annotation"]]]]
      ],
      "paint": {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 4, 4.8, 9, 8.5],
        "circle-color": "rgba(236,228,210,0.94)"
      }
    },
    {
      "id": "study-sites",
      "type": "circle",
      "source": "atlas",
      "source-layer": "study_labels",
      "filter": [
        "all",
        [">=", ["index-of", "__PLATE__", ["coalesce", ["get", "plates"], ""]], 0],
        ["!", ["in", ["get", "category"], ["literal", ["plain", "mountain", "pass", "bay", "sea", "region", "external_polity", "annotation"]]]]
      ],
      "paint": {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 4, 3, 9, 5.5],
        "circle-color": "__ACCENT__",
        "circle-stroke-color": "#3d3026",
        "circle-stroke-width": 0.8
      }
    },
    {
      "id": "region-labels",
      "type": "symbol",
      "source": "atlas",
      "source-layer": "historical_regions",
      "filter": ["==", ["get", "period"], "__PERIOD__"],
      "layout": {
        "text-field": ["coalesce", ["get", "map_label"], ["get", "name_en"]],
        "text-font": ["Georgia", "Palatino Linotype", "Times New Roman"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 14, 8, 22],
        "text-letter-spacing": 0.08,
        "text-transform": "uppercase",
        "text-allow-overlap": false,
        "text-padding": 8
      },
      "paint": {
        "text-color": "#3f3228",
        "text-halo-color": "rgba(236,228,210,0.88)",
        "text-halo-width": 2
      }
    },
    {
      "id": "reference-labels",
      "type": "symbol",
      "source": "atlas",
      "source-layer": "reference_labels",
      "layout": {
        "text-field": ["get", "map_label"],
        "text-font": ["Georgia", "Palatino Linotype", "Times New Roman"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          3, ["match", ["get", "label_type"], "sea", 12, 9],
          8, ["match", ["get", "label_type"], "sea", 18, 13]
        ],
        "text-letter-spacing": 0.1,
        "text-allow-overlap": false,
        "symbol-sort-key": ["coalesce", ["get", "rank"], 5]
      },
      "paint": {
        "text-color": "#31596b",
        "text-opacity": 0.68,
        "text-halo-color": "rgba(228,236,233,0.9)",
        "text-halo-width": 1.7
      }
    },
    {
      "id": "river-labels",
      "type": "symbol",
      "source": "atlas",
      "source-layer": "rivers_primary",
      "minzoom": 6,
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 520,
        "text-field": [
          "match", ["get", "name_ja"],
          "石狩川", "Ishikari River",
          "天塩川", "Teshio River",
          "十勝川", "Tokachi River",
          "北上川", "Kitakami River",
          "最上川", "Mogami River",
          "阿武隈川", "Abukuma River",
          "利根川", "Tone River",
