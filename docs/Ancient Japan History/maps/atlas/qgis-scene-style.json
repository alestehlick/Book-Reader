{
  "version": 8,
  "name": "Ancient Japan — QGIS-faithful chapter scene",
  "sources": {
    "qgis-scene": {
      "type": "raster",
      "tiles": ["__QGIS_SCENE_TILES__"],
      "tileSize": 256,
      "minzoom": 3,
      "maxzoom": 9,
      "bounds": "__QGIS_SCENE_BOUNDS__"
    },
    "chapter-features": {
      "type": "geojson",
      "data": "__CHAPTER_FEATURES__"
    },
    "chapter-routes": {
      "type": "geojson",
      "data": "__CHAPTER_ROUTES__"
    },
    "chapter-regions": {
      "type": "geojson",
      "data": "__CHAPTER_REGIONS__"
    }
  },
  "layers": [
    {
      "id": "paper-sea",
      "type": "background",
      "paint": {"background-color": "#dce8eb"}
    },
    {
      "id": "qgis-scene-render",
      "type": "raster",
      "source": "qgis-scene",
      "paint": {
        "raster-opacity": 1,
        "raster-fade-duration": 0,
        "raster-resampling": "linear"
      }
    },
    {
      "id": "chapter-region-hit",
      "type": "fill",
      "source": "chapter-regions",
      "filter": [">=", ["index-of", "__SCENE__", ["coalesce", ["get", "scenes"], ""]], 0],
      "paint": {"fill-color": "#000000", "fill-opacity": 0.001}
    },
    {
      "id": "chapter-route-hit",
      "type": "line",
      "source": "chapter-routes",
      "filter": [">=", ["index-of", "__SCENE__", ["coalesce", ["get", "scenes"], ""]], 0],
      "paint": {"line-color": "#000000", "line-opacity": 0.001, "line-width": 14}
    },
    {
      "id": "chapter-feature-hit",
      "type": "circle",
      "source": "chapter-features",
      "filter": [">=", ["index-of", "__SCENE__", ["coalesce", ["get", "scenes"], ""]], 0],
      "paint": {"circle-color": "#000000", "circle-opacity": 0.001, "circle-radius": 12}
    }
  ]
}
